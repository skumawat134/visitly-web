{
  "version": "1.0.0",
  "description": "Visitly shell application for the Visitly platform",
  "name": "@visitly/shell",
  "scripts": {
    "dev": "webpack serve --config webpack.dev.js --env NODE_ENV=development",
    "start": "npm run dev",
    "build": "webpack --config webpack.prod.js --env NODE_ENV=production",
    "build:staging": "webpack --config webpack.prod.js --env NODE_ENV=staging",
    "build:dev-test": "webpack --config webpack.prod.js --env NODE_ENV=development",
    "watch": "webpack --watch",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.17",
    "@visitly/app-store": "^0.0.1",
    "@visitly/ui": "*",
    "@visitly/api-client": "*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.12.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@repo/tailwind-config": "*",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "babel-loader": "^10.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "css-loader": "^7.1.2",
    "dotenv-webpack": "^8.1.1",
    "html-webpack-plugin": "^5.6.5",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.1.18",
    "ts-loader": "^9.x",
    "typescript": "^5.9.2",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^6.0.1",
    "workbox-webpack-plugin": "^7.4.0"
  }

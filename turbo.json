{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "**/.env*"],
      "outputs": ["dist/**"],
      "env": ["VITE_AUTH_MFE_REMOTE_URL" ,"VITE_ANGULAR_MFE_REMOTE_URL","VITE_HOST_MFE_REMOTE_URL","VITE_*"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
